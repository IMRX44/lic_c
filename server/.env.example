# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/licensedb

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-strong-random-secret-key-at-least-32-chars
ED25519_PRIVATE_KEY_PATH=./keys/ed25519_private.pem
ED25519_PUBLIC_KEY_PATH=./keys/ed25519_public.pem

# Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-strong-password

# Session
SESSION_KEY_TTL_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=60
GRACE_PERIOD_SECONDS=180

# Rate limiting
RATE_LIMIT_ACTIVATE=5/minute
RATE_LIMIT_HEARTBEAT=10/minute

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
DOMAIN=https://yourdomain.com
